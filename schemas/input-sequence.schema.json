{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handheld input sequence",
  "description": "A bounded timeline of semantic controls for run_input_sequence.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional editor hint pointing to this schema."
    },
    "name": {
      "$ref": "#/$defs/name",
      "description": "Human-readable run name. Defaults to the plan filename."
    },
    "default_hold_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000,
      "default": 120,
      "description": "Default tap, hold, and chord duration in milliseconds."
    },
    "default_timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000,
      "default": 3000,
      "description": "Timeout for one command-adapter invocation."
    },
    "max_runtime_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000,
      "default": 60000,
      "description": "Hard upper bound for the complete run."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/wait"},
          {"$ref": "#/$defs/mark"},
          {"$ref": "#/$defs/tap"},
          {"$ref": "#/$defs/hold"},
          {"$ref": "#/$defs/chord"},
          {"$ref": "#/$defs/down"},
          {"$ref": "#/$defs/up"},
          {"$ref": "#/$defs/axis"},
          {"$ref": "#/$defs/move"}
        ]
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": ".*\\S.*"
    },
    "control": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "description": "Semantic control name understood by the selected adapter."
    },
    "duration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000,
      "default": 0,
      "description": "Delay after this step completes."
    },
    "timeout": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000,
      "description": "Override the plan's command timeout for this step."
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "duration_ms"],
      "properties": {
        "action": {"const": "wait"},
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      }
    },
    "mark": {
      "type": "object",
      "description": "Write a named log record without inspecting target state.",
      "additionalProperties": false,
      "required": ["action", "name"],
      "properties": {
        "action": {"const": "mark"},
        "name": {"$ref": "#/$defs/name"},
        "after_ms": {"$ref": "#/$defs/after"}
      }
    },
    "tap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "control"],
      "properties": {
        "action": {"const": "tap"},
        "control": {"$ref": "#/$defs/control"},
        "hold_ms": {"$ref": "#/$defs/duration"},
        "after_ms": {"$ref": "#/$defs/after"},
        "timeout_ms": {"$ref": "#/$defs/timeout"}
      }
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "control"],
      "properties": {
        "action": {"const": "hold"},
        "control": {"$ref": "#/$defs/control"},
        "duration_ms": {"$ref": "#/$defs/duration"},
        "after_ms": {"$ref": "#/$defs/after"},
        "timeout_ms": {"$ref": "#/$defs/timeout"}
      }
    },
    "chord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "controls"],
      "properties": {
        "action": {"const": "chord"},
        "controls": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/control"}
        },
        "duration_ms": {"$ref": "#/$defs/duration"},
        "after_ms": {"$ref": "#/$defs/after"},
        "timeout_ms": {"$ref": "#/$defs/timeout"}
      }
    },
    "down": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "control"],
      "properties": {
        "action": {"const": "down"},
        "control": {"$ref": "#/$defs/control"},
        "after_ms": {"$ref": "#/$defs/after"},
        "timeout_ms": {"$ref": "#/$defs/timeout"}
      }
    },
    "up": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "control"],
      "properties": {
        "action": {"const": "up"},
        "control": {"$ref": "#/$defs/control"},
        "after_ms": {"$ref": "#/$defs/after"},
        "timeout_ms": {"$ref": "#/$defs/timeout"}
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "control", "value"],
      "properties": {
        "action": {"const": "axis"},
        "control": {"$ref": "#/$defs/control"},
        "value": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Normalized value. Trigger adapters normally accept only 0 through 1."
        },
        "duration_ms": {
          "$ref": "#/$defs/duration",
          "description": "When set, return this axis to zero after the duration."
        },
        "after_ms": {"$ref": "#/$defs/after"},
        "timeout_ms": {"$ref": "#/$defs/timeout"}
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "control", "value"],
      "properties": {
        "action": {"const": "move"},
        "control": {"$ref": "#/$defs/control"},
        "value": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767,
          "description": "One relative pointer movement or wheel delta."
        },
        "after_ms": {"$ref": "#/$defs/after"},
        "timeout_ms": {"$ref": "#/$defs/timeout"}
      }
    }
  }
}
